# ==============================================================================
# Aegis-X .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
myenv/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
*.env
!.env.example

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/

# OS generated files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Application logs, telemetry, runtime cache
logs/
*.log
*.sqlite
*.sqlite3
*.db

# Scanned data, report exports, quarantine storage
data/
data/cache/
data/quarantine/
data/reports/

# Generated demo / test malware samples (do not commit test threats or EICAR)
demo_samples/
test_samples/

# Testing & coverage
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
