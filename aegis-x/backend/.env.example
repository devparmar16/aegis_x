# =========================================================
# Aegis-X — AI-Powered Endpoint Security Platform
# Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit your actual .env to version control.
# =========================================================

# --- Scan Folders ---
# Comma-separated list of absolute paths for Aegis-X to watch and scan.
# These are the folders whose files will be analyzed.
# Defaults to the current user's Downloads folder if not set.
#
# Examples (Windows):
#   SCAN_FOLDERS=C:\Users\YourName\Downloads
#   SCAN_FOLDERS=C:\Users\YourName\Downloads,C:\Users\YourName\Desktop,D:\Quarantine
SCAN_FOLDERS=C:\Users\YourName\Downloads

# Whether to scan folders recursively (includes sub-directories).
# Set to true to scan all sub-folders as well.
SCAN_RECURSIVE=false

# Seconds to wait after a file stabilizes before analysis begins.
# Guards against locked / still-writing files.
FILE_STABILIZE_DELAY_SECONDS=2

# Extensions ignored entirely (comma-separated, no dots needed).
IGNORED_EXTENSIONS=crdownload,tmp,part,download

# --- AI Provider ---
# One of: groq, gemini, openai, ollama, none
AI_PROVIDER=none

GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model name used for the selected provider (ignored when provider=none)
MODEL_NAME=llama-3.1-8b-instant

# Only used when AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Timeout (seconds) for any AI provider HTTP call.
AI_REQUEST_TIMEOUT_SECONDS=20

# --- Database ---
DATABASE_PATH=./data/aegis_x.db

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/aegis_x.log

# --- UI ---
# Automatically pop up the Tkinter report window when analysis completes.
AUTO_OPEN_POPUP=true

# --- Web API / Dashboard ---
API_HOST=127.0.0.1
API_PORT=8000

# --- ClamAV (clamd socket) ---
# Aegis-X connects to a running clamd daemon via TCP socket.
# Install ClamAV and start the clamd service, then enable here.
# Windows: install ClamAV for Windows, configure clamd.conf, start clamd service.
CLAMAV_ENABLED=true
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310

# --- YARA ---
# Path to directory containing .yar / .yara rule files.
# Subdirectories are scanned recursively for rules.
YARA_ENABLED=true
YARA_RULES_DIR=./rules/yara

# --- Scanner Timeouts ---
# Per-scanner timeout in seconds (scanner is cancelled if exceeded).
SCANNER_TIMEOUT_SECONDS=30
# Total scan timeout across all scanners for one file.
SCAN_TIMEOUT_SECONDS=120

# --- Threat Intelligence ---
# Set THREAT_INTEL_ENABLED=true and provide at least one API key.
THREAT_INTEL_ENABLED=false
VIRUSTOTAL_API_KEY=
MALWAREBAZAAR_API_KEY=

# --- System Enumeration ---
# How often (seconds) to re-enumerate running processes, services, etc.
SYSTEM_SCAN_INTERVAL_SECONDS=60
